# Port the HTTP server listens on
PORT=3000

# Supabase / PostgreSQL connection string
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (or "URI")
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Any long random string. Used to sign JWTs.
JWT_SECRET=change_this_to_a_long_random_string

# Comma separated list of allowed origins for CORS (web + flutter web)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*

# Supabase Storage for avatars (public bucket)
# Found in Supabase Dashboard -> Project Settings -> API
# Use the "service_role" key so the server can write without RLS (never expose it to clients).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY